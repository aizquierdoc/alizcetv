{
  "manifest_version": 3,
  "name": "Back or Close",
  "version": "5.0",
  "description": "Clic derecho: volver atras o cerrar ventana.",
  "permissions": ["tabs", "windows"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
