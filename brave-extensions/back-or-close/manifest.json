{
  "manifest_version": 3,
  "name": "Back or Close",
  "version": "1.3",
  "description": "Ctrl+W vuelve atras si hay historial, o cierra la ventana si estas en la home.",
  "permissions": ["tabs", "windows", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
